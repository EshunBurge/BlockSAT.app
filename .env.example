# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings


# --- Database (Supabase Postgres) ---
# 1. Create a project at https://supabase.com
# 2. Click "Connect" at the top of your Supabase project dashboard -> ORMs tab (or the
#    pooler connection strings) and copy both:
#    - the transaction-mode pooler URL (port 6543) -> DATABASE_URL (used by the app at runtime)
#    - the session-mode pooler URL (port 5432) -> DIRECT_URL (used only by `prisma migrate`)
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (client + server) ---
# NEXT_PUBLIC_SUPABASE_URL is your project's API URL, e.g. https://abcdefgh.supabase.co
# (Settings -> API -> Project URL). It is NOT the dashboard link.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Use the new publishable/secret key pair (Settings -> API Keys -> "Publishable
# and secret API keys" tab) rather than the legacy anon/service_role keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# Set to "true" to run without a real Supabase project using the built-in
# local dev-auth fallback (cookie-based mock sessions). Great for demos.
NEXT_PUBLIC_DEV_AUTH="true"

# Comma-separated emails granted ADMIN role on first profile creation
ADMIN_EMAILS="eshunburge@gmail.com"

# --- Live AI question generation (optional) ---
# Leave blank to use the built-in question bank only. Get a free key (no
# credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
